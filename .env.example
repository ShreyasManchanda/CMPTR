# --- API Keys ---
FIRECRAWL_API_KEY=your_firecrawl_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: when set, clients must send header X-API-Key
# CMPT_API_KEY=

# --- Database ---
# Format: postgresql://user:password@host:port/database_name
# Note: 'db' corresponds to the postgres container inside docker-compose.yml.
# If running the Python backend outside of Docker, change 'db' to 'localhost'.
DATABASE_URL=postgresql://postgres:1234@db:5432/cmpt_db

# Comma-separated frontend origins (use * only for open local debugging)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# In-memory rate limit for /analyze and /discover-competitors
RATE_LIMIT_WINDOW_SEC=60
RATE_LIMIT_MAX=10
