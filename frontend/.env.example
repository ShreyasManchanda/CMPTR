# ── CMPT Frontend Environment Variables ──

# Backend API base URL (no trailing slash)
VITE_API_BASE_URL=http://localhost:8000

# Optional — must match backend CMPT_API_KEY when that is set
# VITE_API_KEY=

# Set to 'false' to call the real backend API.
# Set to 'true' to use mock data for demo/offline work.
VITE_USE_MOCK=false
